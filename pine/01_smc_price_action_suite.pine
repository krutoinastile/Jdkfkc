bool   showToday  = input.bool(true,  "Маркер «СЕГОДНЯ»",                    group = G_NEWS)
string txtToday   = input.string("СЕГОДНЯ", "Текст маркера дня",             group = G_NEWS)
bool   showRisk   = input.bool(true,  "Плашка риска по событиям",            group = G_NEWS)
string txtRisk    = input.string("⚠ РИСК", "Текст плашки риска",             group = G_NEWS)
