BOT_TOKEN=123456789:replace-with-telegram-bot-token
ADMIN_IDS=123456789
DATABASE_URL=sqlite+aiosqlite:///./data/tradingbot.db
LOG_LEVEL=INFO
SYMBOL=BTCUSDT
TIMEFRAME=1h
SCAN_INTERVAL_MINUTES=15
TRADE_CHECK_INTERVAL_MINUTES=5
NOTIFY_ON_SIGNAL=true
INVOICE_POLL_SECONDS=15
# Crypto Pay webhook (optional — set WEBHOOK_PORT=8080 and point URL in @CryptoBot)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=0
CRYPTOPAY_WEBHOOK_PATH=/cryptopay/webhook
# BingX API (optional — auto-trading scaffold)
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_TESTNET=false
# Crypto Pay token задаётся в админке: 💎 Подписка → 🔑 Crypto Pay token
